<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme — provides colorPrimary for system chrome and SAF picker.
         Compose handles all real UI theming via LibravaultTheme, but the
         XML-level theme controls status/nav bars, splash, and system dialogs. -->
    <style name="Theme.Libravault" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#8B5E3C</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
