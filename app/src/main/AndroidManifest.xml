<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        PERMISSIONS POLICY — Libravault never requests:
          READ_EXTERNAL_STORAGE, WRITE_EXTERNAL_STORAGE, MANAGE_EXTERNAL_STORAGE
        File access is granted solely via Storage Access Framework (SAF) URIs
        chosen explicitly by the user.

        AGP's ManifestMerger2 (com.android.manifmerger.XmlDocument) auto-injects
        READ_PHONE_STATE, READ_EXTERNAL_STORAGE and WRITE_EXTERNAL_STORAGE as a
        legacy permission-split compatibility shim, keyed off the *lowest*
        minSdkVersion declared by any merged library manifest (several AndroidX/
        Readium transitive deps still declare minSdkVersion 14-19), even though
        this app's own effective minSdk is 31 and nothing in the source tree
        requests them. Confirmed via a clean build + manifest-merger-blame
        report: no dependency AAR's own manifest declares any of the three: the
        strings live in AGP's manifest-merger jar itself, not in any of our
        dependencies. Explicitly removed here so they don't ship or keep getting
        flagged in reviews (see F-Droid MR !43520 note_3686431461).
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- Donation payment verification (BTCPay invoice polling) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Background audio playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Playback notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LibravaultApp"
        android:label="LibraVault"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Libravault"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LibraVault.Splash"
            tools:ignore="AppLinkUrlError">

            <!-- Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ── EPUB ─────────────────────────────────────────────────── -->
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" android:scheme="content" android:pathPattern=".*\.epub" />
            </intent-filter>

            <!-- ── PDF ──────────────────────────────────────────────────── -->
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" android:scheme="content" android:pathPattern=".*\.pdf" />
            </intent-filter>

            <!-- ── MP3 ──────────────────────────────────────────────────── -->
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/mpeg" />
            </intent-filter>
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" android:scheme="content" android:pathPattern=".*\.mp3" />
            </intent-filter>

            <!-- ── M4B ──────────────────────────────────────────────────── -->
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/x-m4b" />
            </intent-filter>
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/mp4" />
            </intent-filter>
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/m4b" />
            </intent-filter>
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" android:scheme="content" android:pathPattern=".*\.m4b" />
            </intent-filter>

            <!-- ── OGG ──────────────────────────────────────────────────── -->
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/ogg" />
            </intent-filter>
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" android:scheme="content" android:pathPattern=".*\.ogg" />
            </intent-filter>

            <!-- ── FLAC ─────────────────────────────────────────────────── -->
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/flac" />
            </intent-filter>
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" android:scheme="content" android:pathPattern=".*\.flac" />
            </intent-filter>

            <!-- ── OPUS ─────────────────────────────────────────────────── -->
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/opus" />
            </intent-filter>
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" android:scheme="content" android:pathPattern=".*\.opus" />
            </intent-filter>

            <!-- ── AAC ──────────────────────────────────────────────────── -->
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/aac" />
            </intent-filter>
            <intent-filter android:label="Open with LibraVault">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" android:scheme="content" android:pathPattern=".*\.aac" />
            </intent-filter>

        </activity>

        <!-- Media3 small-icon override for DefaultMediaNotificationProvider.
             Without this, the playback notification falls back to the system's
             default small-icon resolution (often the app launcher). Setting it
             here keeps the notification icon distinct from the launcher so the
             notification stays visually recognizable when collapsed. -->
        <meta-data
            android:name="androidx.media3.session.SMALL_ICON_RESOURCE"
            android:resource="@drawable/ic_notification" />

        <!-- M3: Media playback service.
             tools:ignore="Instantiatable" suppresses a lint false-positive:
             PlaybackService extends Media3's MediaSessionService which extends
             android.app.Service, but lint cannot resolve the chain through the AAR. -->
        <service
            android:name="xyz.libravault.feature.player.service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>

</manifest>
