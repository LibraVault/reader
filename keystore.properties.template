# keystore.properties.template
#
# Copy this file to keystore.properties and fill in your signing credentials.
# keystore.properties is listed in .gitignore and must NEVER be committed.
#
# To generate a keystore:
#   keytool -genkey -v \
#     -keystore libravault-release.keystore \
#     -alias libravault \
#     -keyalg RSA \
#     -keysize 4096 \
#     -validity 10000
#
# Keep libravault-release.keystore in a secure location (e.g. a password manager).
# Back it up — losing it means you can never update your Play Store listing.

storeFile=../libravault-release.keystore
storePassword=CHANGE_ME
keyAlias=libravault
keyPassword=CHANGE_ME
