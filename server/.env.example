# Libravault donation proxy — environment variables
#
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# All variables below are required; the proxy refuses to start if any are
# still placeholders.

# ── BTCPay (server-to-server; NOT sent to the Android client) ───────────────

# API key issued by your BTCPay instance under Store → Settings → Access Tokens.
# Needs the `btcpay.store.cancreateinvoice` scope at minimum.
BTCPAY_API_KEY=REPLACE_WITH_BTCPAY_API_KEY

# Your BTCPay root URL.
BTCPAY_URL=https://pay.example.com

# Your BTCPay store id (a base58 string from Store → Settings → General).
STORE_ID=REPLACE_WITH_BTCPAY_STORE_ID

# ── Android client auth (sent in `Authorization: Bearer <value>`) ──────────

# A high-entropy shared secret. Generate with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Paste the same value into:
#   app/src/main/res/values/secrets.xml (or a BuildConfig field) so the
#   Android client can attach it to every /donate/* call.
# Rotate by deploying a new secret to both sides in a coordinated release.
PROXY_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_BASE64URL_SECRET

# ── Listen port ─────────────────────────────────────────────────────────────
PORT=3456